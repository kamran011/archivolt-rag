# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql+asyncpg://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Auth
JWT_SECRET=your-jwt-secret-from-supabase-settings

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: send chat / rerank / vision calls to any OpenAI-compatible API, e.g. OpenRouter.
# Embeddings are separate (EMBEDDING_BASE_URL / EMBEDDING_API_KEY) because free OpenRouter
# models are chat-only, so keep OPENAI_API_KEY for embeddings.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# DEFAULT_LLM_MODEL=<openrouter model id, e.g. something ending in :free>
# RERANKER_MODEL=<openrouter model id>

# Reranking: llm (default, uses RERANKER_MODEL) | cohere | none
RERANKER_PROVIDER=llm
COHERE_API_KEY=

# App
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- V2 (all optional; defaults keep V1 behavior) ---
# CACHE_BACKEND=redis            # memory (default) | redis
# REDIS_URL=redis://localhost:6379/0
# ENABLE_EMBEDDING_CACHE=true
# ENABLE_RERANK_CACHE=true
# ENABLE_RESPONSE_CACHE=true     # invalidate-on-write + verify-on-hit
# ENABLE_QUERY_TRANSFORM=true    # query rewrite / multi-query / decomposition
# DECISION_PROVIDER=rules        # rules | llm | jev (JEV_ENDPOINT, JEV_API_KEY)
# ENABLE_COST_AWARE_ROUTING=true
# CHEAP_LLM_MODEL=gpt-4o-mini
# EXTERNAL_API_SOURCES={"orders": {"url": "https://api.example.com/orders", "description": "order status"}}
